{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "records-provider",
  "main": "apps/record-provider/src/index.ts",
  "compatibility_date": "2025-11-29",
  "compatibility_flags": [],
  "preview_urls": false,
  "workers_dev": false,
  "minify": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "RECORD_CACHE",
      "id": "00000000000000000000000000000000"
    }
  ]
}
