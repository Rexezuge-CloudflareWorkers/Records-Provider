{
  "name": "@record-provider/monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm run typegen",
    "build": "pnpm -r build",
    "checks": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:god-files && pnpm run test:coverage",
    "prettier": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && pnpm run typecheck:test",
    "typecheck:test": "tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:god-files": "tsx node_modules/@rexezuge/tooling/src/scripts/check-god-files.ts",
    "lint": "eslint --fix --quiet .",
    "typegen": "wrangler types --config ./apps/record-provider/wrangler.template.jsonc --env-interface CloudflareEnv",
    "prepare-config": "WRANGLER_TEMPLATE_PATH=apps/record-provider/wrangler.template.jsonc tsx scripts/prepare-wrangler-config.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@rexezuge/errors": "1.9.2",
    "@rexezuge/runtime": "1.9.2",
    "@rexezuge/shared": "1.9.2",
    "@rexezuge/tooling": "1.9.2",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.13.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "wrangler": "4.150.0"
  },
  "packageManager": "pnpm@11.2.2"
}
